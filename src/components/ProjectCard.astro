---
import ArchitectureDiagram from './diagram/ArchitectureDiagram.tsx';
import StatusPill from './StatusPill.astro';
import StackChip from './StackChip.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { t as tx, type Project } from '../lib/projects';

interface Props { project: Project; locale: Locale }
const { project: p, locale } = Astro.props;
const t = useTranslations(locale);
const title = tx(p.title, locale);
---
<article class="card group relative flex flex-col overflow-hidden transition-shadow hover:shadow-[var(--shadow-lift)]">
  <div class="p-2.5 pb-0">
    <ArchitectureDiagram architecture={p.architecture} locale={locale} mode="compact" title={title} />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex flex-wrap items-center gap-2">
      <StatusPill status={p.status} locale={locale} />
      <span class="font-mono text-xs text-ink-2">{p.year}</span>
    </div>
    <h3 class="display-md text-xl">
      <a href={localePath(locale, `/projects/${p.slug}`)} class="after:absolute after:inset-0 after:content-[''] focus-visible:after:rounded-[18px]">{title}</a>
    </h3>
    <p class="text-sm text-ink-2">{tx(p.tagline, locale)}</p>
    <div class="mt-auto flex flex-wrap gap-1.5 pt-1">
      {p.stack.slice(0, 4).map((s) => <StackChip name={s.name} category={s.category} />)}
    </div>
    <span class="pt-2 text-sm font-semibold text-cobalt">{t('card.open')}</span>
  </div>
</article>
