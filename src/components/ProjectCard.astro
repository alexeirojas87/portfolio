---
import ArchitectureDiagram from './diagram/ArchitectureDiagram.tsx';
import { IconArrow } from './diagram/icons.tsx';
import StatusPill from './StatusPill.astro';
import StackChip from './StackChip.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { t as tx, type Project } from '../lib/projects';

interface Props {
  project: Project;
  locale: Locale;
  index: number;
  total: number;
}
const { project: p, locale, index, total } = Astro.props;
const t = useTranslations(locale);
const title = tx(p.title, locale);
const href = localePath(locale, `/projects/${p.slug}`);
const num = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
---
<article class="project">
  <span class="num">{num}</span>
  <div class="media">
    <ArchitectureDiagram architecture={p.architecture} locale={locale} mode="compact" title={title} />
  </div>
  <div class="body">
    <div class="kicker"><StatusPill status={p.status} locale={locale} /></div>
    <h3 class="title"><a href={href}>{title}</a></h3>
    <p class="tag">{tx(p.tagline, locale)}</p>
    <div class="stack">
      {p.stack.slice(0, 4).map((s) => <StackChip name={s.name} category={s.category} />)}
    </div>
  </div>
  <span class="open" aria-hidden="true">{t('card.open')}<IconArrow size={14} /></span>
</article>
