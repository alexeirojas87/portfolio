---
import Base from '../layouts/Base.astro';
import { useTranslations, type Locale, type UiKey } from '../i18n/ui';
import { capabilityGroups, CAREER_START_YEAR } from '../lib/profile';
import { PERSON, SITE_URL } from '../lib/site';
import { ogImagePath, personJsonLd } from '../lib/seo';
import { CLASS_COLOR } from '../components/diagram/kinds';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const career = [1, 2, 3, 4].map((n) => ({ when: t(`about.career.${n}.when` as UiKey), what: t(`about.career.${n}.what` as UiKey) }));
const research = [1, 2, 3, 4].map((n) => t(`about.research.${n}` as UiKey));
const personLd = personJsonLd({ site: SITE_URL, locale, name: PERSON.name, jobTitle: PERSON.jobTitle, sameAs: PERSON.sameAs, knowsAbout: capabilityGroups.flatMap((g) => g.items), description: t('about.lead', { year: CAREER_START_YEAR }) });
---
<Base locale={locale} title={t('about.title')} description={t('about.lead', { year: CAREER_START_YEAR })} image={ogImagePath('page', 'about', locale)} jsonLd={[personLd]}>
  <div class="wrap pt-14">
    <p class="eyebrow">{t('about.eyebrow')}</p>
    <h1 class="display mt-3 text-[clamp(2.2rem,5vw,3.6rem)]">{t('about.title')}</h1>
    <p class="mt-5 max-w-3xl font-display text-2xl font-bold leading-snug tracking-tight">{t('about.lead', { year: CAREER_START_YEAR })}</p>
    <div class="mt-5 grid max-w-3xl gap-4 text-ink-2">
      <p>{t('about.summary.1')}</p>
      <p>{t('about.summary.2')}</p>
    </div>
  </div>

  <section class="wrap mt-16">
    <h2 class="section-title">{t('about.capabilities')}</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {capabilityGroups.map((g) => (
        <article class="card p-5">
          <h3 class="flex items-center gap-2 font-display text-lg font-bold tracking-tight">
            <span aria-hidden="true" class="h-3 w-3 rounded" style={`background:${CLASS_COLOR[g.tone]}`}></span>
            {t(`about.cap.${g.id}` as UiKey)}
          </h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {g.items.map((i) => <li class="chip" style={`--c:${CLASS_COLOR[g.tone]}`}><span class="dot" aria-hidden="true"></span>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap mt-16">
    <h2 class="section-title">{t('about.career')}</h2>
    <ol class="mt-8 border-l-2 border-rule pl-6">
      {career.map((c) => (
        <li class="relative pb-8 last:pb-0">
          <span aria-hidden="true" class="absolute -left-[33px] top-1.5 h-3 w-3 rounded-full border-2 border-cobalt bg-page"></span>
          <p class="font-mono text-sm font-medium text-cobalt">{c.when}</p>
          <p class="mt-1 max-w-2xl">{c.what}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap mt-16 grid gap-6 md:grid-cols-2">
    <div class="card p-5">
      <h2 class="display-md text-xl">{t('about.research')}</h2>
      <ul class="mt-3 grid gap-2 text-sm">{research.map((r) => <li class="flex gap-2"><span aria-hidden="true" class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-cobalt"></span>{r}</li>)}</ul>
    </div>
    <div class="card p-5">
      <h2 class="display-md text-xl">{t('about.education')}</h2>
      <ul class="mt-3 grid gap-2 text-sm">
        <li><strong>{t('about.education.degree')}</strong> <span class="font-mono text-ink-2">2013</span></li>
        <li>{t('about.education.training.1')}</li>
        <li>{t('about.education.training.2')}</li>
      </ul>
      <h2 class="display-md mt-6 text-xl">{t('about.languages')}</h2>
      <ul class="mt-3 grid gap-1 text-sm"><li>{t('about.lang.es')}</li><li>{t('about.lang.en')}</li></ul>
    </div>
  </section>

  <section class="wrap mt-16">
    <h2 class="section-title">{t('about.contact')}</h2>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="mailto:alexeirojas87@gmail.com">alexeirojas87@gmail.com</a>
      <a class="btn btn-ghost" href="https://linkedin.com/in/alexeirojas87" rel="noopener">linkedin.com/in/alexeirojas87</a>
      <a class="btn btn-ghost" href="https://github.com/alexeirojas87" rel="noopener">github.com/alexeirojas87</a>
    </div>
  </section>
</Base>
