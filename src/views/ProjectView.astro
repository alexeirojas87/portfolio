---
import Base from '../layouts/Base.astro';
import ProjectDiagram from '../components/diagram/ProjectDiagram.tsx';
import { buildViews } from '../components/diagram/views';
import StatusPill from '../components/StatusPill.astro';
import StackChip from '../components/StackChip.astro';
import { useTranslations, localePath, type Locale, type UiKey } from '../i18n/ui';
import { getProjects, t as tx, type Project } from '../lib/projects';

interface Props { project: Project; locale: Locale }
const { project: p, locale } = Astro.props;
const t = useTranslations(locale);
const all = await getProjects();
const idx = all.findIndex((x) => x.slug === p.slug);
const prev = all[(idx - 1 + all.length) % all.length];
const next = all[(idx + 1) % all.length];
const title = tx(p.title, locale);

const groups = new Map<string, Project['stack']>();
for (const s of p.stack) groups.set(s.category, [...(groups.get(s.category) ?? []), s]);
const stackKey = (c: string) => `stack.${c}` as UiKey;

const video = p.video;
const isFile = video ? /\.(mp4|webm)(\?|$)/i.test(video.url) : false;
const storyUrl = `/stories/?story=${p.slug}&lang=${locale}`;
const links = [
  p.links.live && { href: p.links.live, label: t('detail.link.live') },
  p.links.github && { href: p.links.github, label: t('detail.link.github') },
].filter((l): l is { href: string; label: string } => !!l);
---
<Base locale={locale} title={title} description={tx(p.tagline, locale)}>
  <div class="wrap-wide pt-5">
    <a href={localePath(locale, '/#work')} class="text-sm font-medium text-ink-2 hover:text-cobalt">← {t('detail.back')}</a>

    <header class="mt-3 grid gap-4 xl:grid-cols-[minmax(0,1fr)_auto] xl:items-end xl:gap-10">
      <div>
        <p class="eyebrow">{t(`detail.category.${p.category}` as const)}{p.category === 'corporate' ? ` · ${t('detail.corporate.note')}` : ''}</p>
        <h1 class="display mt-2 text-[clamp(1.7rem,3vw,2.8rem)]">{title}</h1>
        <p class="mt-2 max-w-3xl text-base text-ink-2 md:text-lg">{tx(p.tagline, locale)}</p>
      </div>
      <dl class="meta flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        <div><dt class="eyebrow">{t('detail.status')}</dt><dd class="mt-0.5"><StatusPill status={p.status} locale={locale} /></dd></div>
        <div class="max-w-lg"><dt class="eyebrow">{t('detail.role')}</dt><dd class="text-[0.82rem] leading-snug">{tx(p.role, locale)}</dd></div>
        {links.map((l) => <a class="btn btn-ghost !px-3 !py-1.5 text-sm" href={l.href} rel="noopener" target="_blank">{l.label} <span aria-hidden="true">↗</span></a>)}
      </dl>
    </header>
  </div>

  <section class="wrap-wide mt-6" aria-labelledby="arch">
    <h2 id="arch" class="sr-only">{t('detail.architecture')}</h2>
    <ProjectDiagram client:load views={buildViews(p)} locale={locale} title={title} />
  </section>

  <div class="wrap mt-16 grid gap-14">
    <section class="grid gap-8 lg:grid-cols-[3fr_2fr]">
      <div>
        <h2 class="section-title">{t('detail.what')}</h2>
        <p class="mt-4 max-w-[68ch] text-ink-2">{tx(p.summary, locale)}</p>
      </div>
      <div class="card p-5">
        <h3 class="eyebrow">{t('detail.problem')}</h3>
        <p class="mt-2">{tx(p.problem, locale)}</p>
      </div>
    </section>

    <section>
      <h2 class="section-title">{t('detail.built')}</h2>
      <ul class="mt-6 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {p.highlights.map((h) => (
          <li class="card flex gap-3 p-4 text-sm">
            <span aria-hidden="true" class="mt-1.5 h-2 w-2 flex-none rounded-full bg-cobalt"></span>
            <span>{tx(h, locale)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="section-title">{t('detail.decisions')}</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {p.decisions.map((d, i) => (
          <article class="card p-5">
            <p class="eyebrow">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="display-md mt-1 text-lg">{tx(d.title, locale)}</h3>
            <p class="mt-2 text-sm text-ink-2">{tx(d.why, locale)}</p>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2 class="section-title">{t('detail.stack')}</h2>
      <dl class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2 xl:grid-cols-4">
        {[...groups.entries()].map(([cat, items]) => (
          <div>
            <dt class="eyebrow">{t(stackKey(cat))}</dt>
            <dd class="mt-2 flex flex-wrap gap-1.5">{items.map((s) => <StackChip name={s.name} category={s.category} />)}</dd>
          </div>
        ))}
      </dl>
    </section>

    {p.story ? (
      <section aria-labelledby="story">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h2 id="story" class="section-title">{t('detail.story')}</h2>
          <a class="btn btn-ghost !px-3 !py-1.5 text-sm" href={storyUrl} target="_blank" rel="noopener">{t('detail.story.fullscreen')} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="story-frame mt-6 overflow-hidden rounded-[18px] border border-rule bg-canvas shadow-[var(--shadow-soft)]">
          <iframe class="story-embed h-full w-full border-0" src={storyUrl} title={`${t('detail.story')}: ${title}`} allow="fullscreen" allowfullscreen loading="lazy"></iframe>
          <div class="story-poster canvas on-canvas">
            <p class="eyebrow">{t('detail.story')}</p>
            <p class="font-display text-xl font-bold">{title}</p>
            <p class="text-sm">{t('detail.story.rotate')}</p>
            <a class="btn btn-ghost !px-3 !py-1.5 text-sm" href={storyUrl} target="_blank" rel="noopener">{t('detail.story.fullscreen')} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <p class="story-hint mt-3 text-sm text-ink-2">{t('detail.story.hint')}</p>
      </section>
    ) : video ? (
      <section>
        <h2 class="section-title">{t('detail.video')}</h2>
        <div class="mt-6 overflow-hidden rounded-[18px] border border-rule bg-canvas shadow-[var(--shadow-soft)]" style="aspect-ratio:16/9">
          {isFile
            ? <video class="h-full w-full" controls preload="metadata" src={video.url} title={video.title ? tx(video.title, locale) : title}></video>
            : <iframe class="h-full w-full" src={video.url} title={video.title ? tx(video.title, locale) : title} allowfullscreen loading="lazy"></iframe>}
        </div>
      </section>
    ) : null}

    <nav aria-label="Projects" class="grid gap-4 sm:grid-cols-2">
      <a class="card block p-5 hover:border-cobalt" href={localePath(locale, `/projects/${prev.slug}`)}>
        <span class="eyebrow">← {t('detail.prev')}</span>
        <span class="display-md mt-1 block text-lg">{tx(prev.title, locale)}</span>
      </a>
      <a class="card block p-5 text-right hover:border-cobalt" href={localePath(locale, `/projects/${next.slug}`)}>
        <span class="eyebrow">{t('detail.next')} →</span>
        <span class="display-md mt-1 block text-lg">{tx(next.title, locale)}</span>
      </a>
    </nav>
  </div>
</Base>

<style>
  .story-frame { aspect-ratio: 16 / 9; position: relative; }
  .story-poster { display: none; }
  /* Phone held upright: the 1920x1080 stage would be unreadable. Show a poster and the fullscreen link instead. */
  @media (orientation: portrait) and (max-width: 700px) {
    .story-frame { aspect-ratio: auto; }
    .story-embed, .story-hint { display: none; }
    .story-poster { display: grid; gap: 0.75rem; justify-items: start; padding: 1.5rem 1.25rem; border-radius: 0; border: 0; box-shadow: none; }
  }
</style>
