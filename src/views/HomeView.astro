---
import Base from '../layouts/Base.astro';
import HeroCanvas from '../components/diagram/HeroCanvas.tsx';
import ProjectCard from '../components/ProjectCard.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { getProjects, t as tx } from '../lib/projects';
import { CLASS_COLOR } from '../components/diagram/kinds';
import { capabilityGroups, CAREER_START_YEAR } from '../lib/profile';
import BootIntro from '../components/BootIntro.tsx';
import { countProjects } from '../lib/intro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const all = await getProjects();
const personal = all.filter((p) => p.category === 'personal');
const corporate = all.filter((p) => p.category === 'corporate');
const featuredSlugs = ['agentic-orchestration', 'wagering-platform', 'apagones-habana'];
const featured = featuredSlugs
  .map((s) => all.find((p) => p.slug === s))
  .filter((p): p is NonNullable<typeof p> => !!p)
  .map((p) => ({ slug: p.slug, title: tx(p.title, locale), href: localePath(locale, `/projects/${p.slug}`), architecture: p.architecture }));
---
<Base locale={locale}>
  <script is:inline>
    // Decide before first paint: play the boot intro once per session, never with reduced motion.
    (function () {
      try {
        var reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        var played = false;
        try { played = sessionStorage.getItem('intro-played') === '1'; } catch (e) {}
        if (!reduced && !played) {
          var h = document.documentElement;
          h.classList.add('intro-pending');
          setTimeout(function () { h.classList.remove('intro-pending'); }, 5000);
        }
      } catch (e) {}
    })();
  </script>
  <BootIntro client:load locale={locale} counts={countProjects(all)} sinceYear={CAREER_START_YEAR} />
  <section class="wrap grid items-center gap-10 pb-14 pt-10 lg:grid-cols-[5fr_7fr] lg:gap-14 lg:pt-14">
    <div>
      <p class="eyebrow">{t('hero.eyebrow')}</p>
      <h1 class="mt-5"><span class="display block text-[clamp(2.4rem,4.4vw,4.6rem)]">{t('hero.title.a')}</span><span class="display soft mt-2 block text-[clamp(1.35rem,2.1vw,2.2rem)]">{t('hero.title.b')}</span></h1>
      <p class="mt-6 max-w-xl text-lg text-ink-2 xl:text-xl">{t('hero.lead', { year: CAREER_START_YEAR })}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="#work">{t('hero.cta.projects')} <span aria-hidden="true">↓</span></a>
        <a class="btn btn-ghost" href={localePath(locale, '/about')}>{t('hero.cta.about')}</a>
      </div>
    </div>
    <HeroCanvas client:load items={featured} locale={locale} />
  </section>

  <section class="border-y border-rule bg-surface" aria-label={t('home.capabilities')}>
    <div class="wrap flex flex-wrap items-center gap-x-3 gap-y-2 py-5">
      <span class="eyebrow mr-2">{t('home.capabilities')}</span>
      {capabilityGroups.flatMap((g) => g.items.slice(0, 4).map((i) => ({ i, tone: g.tone }))).map(({ i, tone }) => (
        <span class="chip" style={`--c:${CLASS_COLOR[tone]}`}><span class="dot" aria-hidden="true"></span>{i}</span>
      ))}
    </div>
  </section>

  <section id="work" class="wrap pt-20">
    <p class="eyebrow">{t('home.work.eyebrow')}</p>
    <h2 class="section-title mt-2">{t('home.work.title')}</h2>

    <div class="mt-12">
      <p class="eyebrow" style="color:var(--cobalt)">{t('home.personal.label')} · {t('home.systems', { n: personal.length })}</p>
      <h3 class="display-md mt-1 text-2xl">{t('home.personal.title')}</h3>
      <p class="mt-2 max-w-2xl text-ink-2">{t('home.personal.note')}</p>
      <div class="cards mt-6">
        {personal.map((p) => <ProjectCard project={p} locale={locale} />)}
      </div>
    </div>

    <div class="mt-20">
      <p class="eyebrow" style="color:var(--cobalt)">{t('home.corporate.label')} · {t('home.systems', { n: corporate.length })}</p>
      <h3 class="display-md mt-1 text-2xl">{t('home.corporate.title')}</h3>
      <p class="mt-2 max-w-2xl rounded-xl border border-rule bg-surface px-4 py-3 text-sm text-ink-2">{t('home.corporate.note')}</p>
      <div class="cards mt-6">
        {corporate.map((p) => <ProjectCard project={p} locale={locale} />)}
      </div>
    </div>
  </section>
</Base>
